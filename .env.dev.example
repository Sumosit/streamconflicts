APP_ENV=development
APP_NAME=StreamConflicts API Dev
DATABASE_URL=sqlite:////data/streamconflicts-dev.sqlite3
UPLOAD_DIR=/uploads
PUBLIC_UPLOAD_URL=https://dev.streamconflicts.com/uploads
CORS_ORIGINS=https://dev.streamconflicts.com,http://localhost:4200
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_EMAIL=editor@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
MAX_IMAGE_SIZE_MB=8
WEB_CONCURRENCY=1

