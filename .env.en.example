APP_ENV=production
APP_NAME=StreamConflicts API (EN)
DATABASE_URL=sqlite:////data/streamconflicts.sqlite3
UPLOAD_DIR=/uploads
PUBLIC_UPLOAD_URL=https://streamconflicts.com/en/uploads
CORS_ORIGINS=https://streamconflicts.com
SITE_LANG=en
SITE_NAME=StreamArchive
SITE_DESCRIPTION=A neutral archive of streamer conflicts: facts, timelines and primary sources.
SITE_BASE_URL=https://streamconflicts.com
SITE_PATH_PREFIX=en
JWT_SECRET=replace-with-a-third-32-character-secret
JWT_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=editor@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-third-long-password
MAX_IMAGE_SIZE_MB=8
WEB_CONCURRENCY=1
