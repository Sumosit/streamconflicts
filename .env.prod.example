APP_ENV=production
APP_NAME=StreamConflicts API
DATABASE_URL=sqlite:////data/streamconflicts.sqlite3
UPLOAD_DIR=/uploads
PUBLIC_UPLOAD_URL=https://streamconflicts.com/uploads
CORS_ORIGINS=https://streamconflicts.com,https://www.streamconflicts.com
SITE_LANG=ru
SITE_NAME=Стримархив
SITE_BASE_URL=https://streamconflicts.com
SITE_PATH_PREFIX=
# Соседняя языковая версия: её sitemap и редактор попадают в корневой robots.txt
ALT_SITE_PATH_PREFIX=en
JWT_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=editor@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-different-long-password
MAX_IMAGE_SIZE_MB=8
WEB_CONCURRENCY=1

